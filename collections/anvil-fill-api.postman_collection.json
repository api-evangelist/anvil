          "name": "Fill a PDF template with data",
          "request": {
            "name": "Fill a PDF template with data",
            "description": {
              "content": "Fill an existing PDF template with JSON data. The template must be created in the Anvil app. Provide the template ID in the path and supply field data in the request body. Returns binary PDF bytes on success.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "fill",
                "{{pdfTemplateID}}.pdf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "versionNumber",
                  "value": "-1",
                  "description": "Version number of the template to fill. Use -1 to fill the unpublished (draft) version."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional title to encode into the PDF document metadata."
                },
                {
                  "key": "fontFamily",
                  "value": "Noto Sans",
                  "type": "text",
                  "description": "Font family to use for text fields. Default is Noto Sans."
                },
                {
                  "key": "fontSize",
                  "value": "10",
                  "type": "text",
                  "description": "Font size for text fields in points."
                },
                {
                  "key": "textColor",
                  "value": "<string>",
                  "type": "text",
                  "description": "Hex color code (6 digits) for text fields."
                },
                {
                  "key": "alignment",
                  "value": "left",
                  "type": "text",
                  "description": "Text alignment for text fields. (This can only be one of left,center,right)"
                },
                {
                  "key": "fontWeight",
                  "value": "normal",
                  "type": "text",
                  "description": "Font weight for text fields. (This can only be one of normal,bold,italic,boldItalic)"
                },
                {
                  "key": "useInteractiveFields",
                  "value": "false",
                  "type": "text",
                  "description": "When true, preserves interactive/fillable fields in the output PDF rather than flattening them."
                },
