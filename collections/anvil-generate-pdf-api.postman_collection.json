          "name": "Generate a PDF from HTML or Markdown",
          "request": {
            "name": "Generate a PDF from HTML or Markdown",
            "description": {
              "content": "Generate a new PDF from HTML/CSS content or structured Markdown. Accepts a JSON payload describing the content type and data. Returns binary PDF bytes on success. For payloads exceeding 1 MB, use multipart/form-data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "generate-pdf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/pdf"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "data",
                  "value": "{\"html\":\"<string>\",\"css\":\"<string>\"}",
                  "type": "text",
                  "description": "(Required) Content to render as a PDF. Format depends on the \"type\" field."
                },
                {
                  "key": "type",
                  "value": "markdown",
                  "type": "text",
                  "description": "Content type of the data payload. Use \"html\" for HTML/CSS content or \"markdown\" for structured Markdown sections. (This can only be one of html,markdown)"
                },
                {
                  "key": "title",
                  "value": "<string>",
                  "type": "text",
                  "description": "Title to encode into the PDF document metadata."
                },
                {
                  "key": "page",
                  "value": "{\"width\":\"<string>\",\"height\":\"<string>\",\"marginTop\":\"<string>\",\"marginBottom\":\"<string>\",\"marginLeft\":\"<string>\",\"marginRight\":\"<string>\"}",
                  "type": "text",
                  "description": ""
                },
                {
                  "key": "fontSize",
                  "value": "<number>",
                  "type": "text",
                  "description": "Font size for Markdown rendering (points). Applies only when type is \"markdown\"."
                },
                {
                  "key": "textColor",
                  "value": "<string>",
                  "type": "text",
                  "description": "Hex color code for text. Applies only when type is \"markdown\"."
                },
                {
                  "key": "fontFamily",
                  "value": "<string>",
                  "type": "text",
                  "description": "Font family for text rendering. Applies only when type is \"markdown\"."
                },
                {
                  "key": "includeTimestamp",
                  "value": "true",
                  "type": "text",
                  "description": "When true, includes a timestamp in the generated PDF. Applies only when type is \"markdown\"."
                },
                {
                  "key": "logo",
                  "value": "{\"src\":\"<uri>\",\"width\":\"<string>\",\"height\":\"<string>\"}",
                  "type": "text",
                  "description": ""
                }
              ]
            }
